NODE_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=12h

# Media node identity (future horizontal scaling / routing)
MEDIA_NODE_ID=media-local-1
MEDIA_NODE_PUBLIC_URL=http://localhost:8080

# mediasoup
MEDIASOUP_WORKERS=2
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_ADDRESS=127.0.0.1
MEDIASOUP_WEBRTC_PORT_BASE=40000
MEDIASOUP_MAX_WORKERS=4
MEDIASOUP_INITIAL_BITRATE=1500000
MEDIASOUP_MAX_INCOMING_BITRATE=3000000
MEDIASOUP_LOG_LEVEL=warn

# Signaling reconnect grace period
RTC_PEER_GRACE_MS=20000
